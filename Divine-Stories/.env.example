# Optional overrides. Copy to .env (gitignored). No API keys are needed by this project.

# Wikimedia asks automated clients to identify themselves with contact info. Adding a contact
# (a URL or an email you choose to share) also reduces rate-limiting of image downloads.
# DS_USER_AGENT=DivineStoriesAssetFetcher/0.1 (https://example.com/contact; you@example.com)

# Voice (edge-tts)
# DS_VOICE=hi-IN-MadhurNeural
# DS_VOICE_RATE=-4%
# DS_VOICE_PITCH=-6Hz

# Branding
# DS_CHANNEL_NAME=Divya Rahasya
# DS_CHANNEL_NAME_HI=दिव्य रहस्य

# Encoding
# DS_CRF=18
# DS_PRESET=medium

# Font (must contain Devanagari; Nirmala UI ships with Windows)
# DS_FONT=C:\Windows\Fonts\Nirmala.ttc
